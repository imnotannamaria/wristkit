    "vitest": "^4.1.5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "kleur": "^4.1.5",
    "picomatch": "^4.0.4",
    "prompts": "^2.4.2",
    "zod": "^4.3.6"
  }
