{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "handlers/**/*.ts",
    "handlers/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx"
  ]
}
