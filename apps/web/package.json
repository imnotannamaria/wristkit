{
  "name": "@wristkit/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "pretypecheck": "velite build --clean",
    "predev": "mkdir -p public && cp ../../packages/registry/shortcuts/wristkit-sync.shortcut public/wristkit-sync.shortcut",
    "dev": "next dev",
    "prebuild": "velite build --clean && mkdir -p public && cp ../../packages/registry/shortcuts/wristkit-sync.shortcut public/wristkit-sync.shortcut",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'if [ \"${CI:-}\" = \"true\" ]; then pnpm exec playwright install --with-deps chromium; fi; playwright test'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "15.5.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "shiki": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "velite": "^0.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.2"
  }
}
